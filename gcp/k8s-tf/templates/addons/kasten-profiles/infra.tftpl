kind: Profile
apiVersion: config.kio.kasten.io/v1alpha1
metadata:
  name: gcp-infra-${workspace}-${creator_label}
  namespace: kasten-io
spec:
  infra:
    credential:
      secretType: GcpServiceAccountKey
      secret:
        apiVersion: v1
        kind: secret
        name: k10secret-gcp-sa-key
        namespace: kasten-io
    type: GCP
  type: Infra
